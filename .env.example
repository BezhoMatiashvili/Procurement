# Copy to .env and adjust. Never commit .env.
PA_ENV=dev                      # dev | prod  (prod refuses to start with insecure defaults)
PA_DATA_DIR=./data              # uploads/, results/, app.db live here (mount an encrypted volume in prod)
PA_MAX_FILE_MB=50
PA_MAX_PAGES=300
PA_RETENTION_DAYS=7

# LLM (Ollama on the internal docker network; never a public host)
PA_OLLAMA_BASE_URL=http://ollama:11434
PA_LLM_MODEL=gemma3:12b
PA_LLM_FAST_MODEL=gemma3:4b
PA_LLM_NUM_CTX=8192
PA_LLM_NUM_THREAD=16
PA_LLM_TIMEOUT_S=900

# Docling
PA_DOCLING_ARTIFACTS_PATH=./models/docling   # pre-downloaded models (scripts/prefetch_models.sh)
PA_DOCLING_NUM_THREADS=12
PA_OCR_LANGS=kat,eng

# Auth: keys are created with `uv run python -m procurement_agent.cli create-key <user>`
# DEV ONLY convenience (ignored when PA_ENV=prod):
PA_DEV_API_KEY=

# --- added: settings that exist in config.py but were missing here ---
# Aggregate token budget across the chunks sent to the LLM in one job
PA_LLM_CHUNK_TOKEN_BUDGET=6000
# Upload types the API accepts
PA_ALLOWED_KINDS=pdf,docx,xlsx
# Cap on generated tokens. Output length dominates CPU latency; this is the main latency knob.
PA_LLM_MAX_OUTPUT_TOKENS=1024
# Docling's own document timeout (it used to share PA_LLM_TIMEOUT_S)
PA_DOCLING_TIMEOUT_S=900
# Request rate limit (slowapi syntax)
PA_RATE_LIMIT=120/minute
# Business-registry snapshot built by `cli load-registry`; absent = registry rules are skipped
# PA_REGISTRY_DB=./data/registry.db
