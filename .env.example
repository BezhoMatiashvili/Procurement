# Copy to .env and adjust. Never commit .env.
#
# Every PA_* variable maps to a field of procurement_agent.config.Settings (prefix PA_, case
# insensitive); the values below are the defaults unless a comment says otherwise. Invalid
# values stop the app at startup rather than being silently corrected.

# ---------------------------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------------------------
PA_ENV=dev                      # dev | prod. prod refuses to start with PA_DEV_API_KEY set or
                                # without PA_DOCLING_ARTIFACTS_PATH, and hides /docs.
PA_DATA_DIR=./data              # uploads/, results/, app.db (mount an encrypted volume in prod)

# ---------------------------------------------------------------------------------------------
# Uploads, quotas and retention
# ---------------------------------------------------------------------------------------------
PA_MAX_FILE_MB=50               # per file. The request-body cap is derived from it: two files
                                # (the act/comparison forms post a pair) plus 1 MB of framing,
                                # counted on the bytes that arrive, not on Content-Length.
PA_MAX_PAGES=300
PA_ALLOWED_KINDS=pdf,docx,xlsx  # subset of pdf,docx,xlsx
PA_RETENTION_DAYS=7             # documents and results are deleted this long after upload
PA_MAX_ACTIVE_JOBS_PER_USER=20  # queued + running jobs one user may hold (single worker thread)

# Requests per client address, fixed window: "<n>/<second|minute|hour|day>". /health, /ready
# and /static are exempt. Behind a proxy the address is only real if FORWARDED_ALLOW_IPS
# (below) trusts that proxy; otherwise every user shares the proxy's single bucket.
PA_RATE_LIMIT=120/minute

# ---------------------------------------------------------------------------------------------
# Authentication and browser sessions
# ---------------------------------------------------------------------------------------------
# API keys are created with `python -m procurement_agent.cli create-key <user>` (shown once).
# The UI exchanges a key for a server-side session; the cookie carries only a session token.
PA_UI_SESSION_HOURS=8           # 1..168; enforced on the server, revoked on logout/key revoke
# DEV ONLY convenience key (prod refuses to start while this is set):
PA_DEV_API_KEY=

# ---------------------------------------------------------------------------------------------
# Job worker
# ---------------------------------------------------------------------------------------------
# How long shutdown waits for the running job. An unfinished job is failed on the next start.
# Keep docker-compose.yml's stop_grace_period above this (it is 60s).
PA_WORKER_STOP_TIMEOUT_S=30

# ---------------------------------------------------------------------------------------------
# LLM (Ollama on the internal docker network; the validator refuses a public host)
# ---------------------------------------------------------------------------------------------
PA_OLLAMA_BASE_URL=http://ollama:11434
PA_LLM_MODEL=gemma3:12b
PA_LLM_FAST_MODEL=gemma3:4b
PA_LLM_NUM_CTX=8192
PA_LLM_NUM_THREAD=16
PA_LLM_TIMEOUT_S=900
# Cap on generated tokens. Output length dominates CPU latency; this is the main latency knob.
PA_LLM_MAX_OUTPUT_TOKENS=1024
# Aggregate (estimated) token budget across the chunks sent to the LLM in one job.
PA_LLM_CHUNK_TOKEN_BUDGET=7800
# Closed-answer-space questions (VAT treatment, plus a check on each generated value). Off by
# default: measured as not paying for itself on the client set. See docs/ACCURACY.md.
PA_LLM_CHOICES=false

# ---------------------------------------------------------------------------------------------
# Docling / OCR
# ---------------------------------------------------------------------------------------------
PA_DOCLING_ARTIFACTS_PATH=./models/docling   # pre-downloaded models (scripts/prefetch_models.sh);
                                             # unset by default, required in prod
PA_DOCLING_NUM_THREADS=12
PA_DOCLING_TIMEOUT_S=900        # Docling's own timeout (separate from PA_LLM_TIMEOUT_S)
PA_OCR_LANGS=kat,eng

# ---------------------------------------------------------------------------------------------
# Acceptance act: prose spelling (AOA.SPELLING)
# ---------------------------------------------------------------------------------------------
# The hunspell ka_GE dictionary (scripts/fetch_spelling_dictionary.py, run by
# prefetch_models.sh). Missing files skip the check with a note in the report; nothing is
# downloaded at runtime. The Docker image carries its own copy and sets this itself.
PA_SPELLING_DICTIONARY_PATH=./models/hunspell
# Check the act's prose words against the dictionary. Measured in docs/ACCURACY.md.
PA_PROSE_SPELLING_ENABLED=true

# ---------------------------------------------------------------------------------------------
# Document comparison
# ---------------------------------------------------------------------------------------------
# Most segments one side may have (a 13-sheet BOQ is ~2600 cells, a Word act ~60 paragraphs).
PA_COMPARE_MAX_SEGMENTS=20000
# Below this overlap the two files are treated as unrelated documents rather than two versions.
PA_COMPARE_MIN_SIMILARITY=0.35
# Offer the "explain with the model" action. The model is never called unless a user presses
# it; false removes the button entirely.
PA_COMPARE_LLM_ENABLED=true
# Changes sent to the model in one batched call.
PA_COMPARE_LLM_MAX_HUNKS=8

# ---------------------------------------------------------------------------------------------
# Acceptance act: the model review of the subject and the services
# ---------------------------------------------------------------------------------------------
# Offer "review with the model" for the notes the rules could not decide. The model may mark a
# note or raise it to a warning; it never clears one or makes it an error. false removes it.
PA_AOA_LLM_ENABLED=true
# Queue the review by itself when a report has such notes. Off: the worker is single-threaded,
# and every report view would put a minute of CPU ahead of other users' uploads.
PA_AOA_LLM_AUTO=false
# Notes one review asks about, and the characters of document text its prompt may hold.
PA_AOA_LLM_MAX_ITEMS=8
PA_AOA_LLM_MAX_CHARS=6000

# ---------------------------------------------------------------------------------------------
# Business registry (optional)
# ---------------------------------------------------------------------------------------------
# Snapshot built by `cli load-registry`; unset = the registry rules report "skipped".
# PA_REGISTRY_DB=./data/registry.db

# ---------------------------------------------------------------------------------------------
# Exchange rates for foreign-currency acts (rule 9)
# ---------------------------------------------------------------------------------------------
# Where the NBG rates come from. "none" is the only source today: a foreign-currency act then
# gets the invoice formula with the days whose rates to look up, and a note that the total in
# lari was not calculated.
# PA_FX_RATE_SOURCE=none

# ---------------------------------------------------------------------------------------------
# Server / deployment (read by uvicorn and docker compose, not by Settings)
# ---------------------------------------------------------------------------------------------
# Peers allowed to set X-Forwarded-For (comma-separated IPs or CIDRs). Client addresses feed
# the audit log and the rate limiter, so never "*". uvicorn reads this from its own process
# environment: the image defaults it to 127.0.0.1, docker-compose.yml sets it to its relay's
# address, and a local `uv run uvicorn` does NOT read it from this file (export it instead).
# FORWARDED_ALLOW_IPS=127.0.0.1
#
# docker-compose.yml only: the internal network's subnet and the relay's fixed address in it.
# Change both together if the default collides with a network on the host.
# PA_INTERNAL_SUBNET=172.30.231.0/24
# PA_PROXY_IP=172.30.231.10
# The relay trusts X-Forwarded-For only from this gateway of its `edge` network.
# PA_EDGE_SUBNET=172.30.232.0/24
# PA_EDGE_GATEWAY=172.30.232.1
